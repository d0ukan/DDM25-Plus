// The one place every colour, size and font of the program comes from. Light by default (owner, 2026-11-21);
// dark when chosen in the settings; switched live. No widget names a colour of its own.
// A plain desktop tool: neutral greys, one accent (blue) for the main action, the selection and the focus, and the
// three status colours (green ok, amber warning, red error) only where a state is shown. Small corners, normal sizes.
// Contrast: every text / background pair below meets WCAG AA (4.5:1, large text and lines 3:1); tests/screens.rs
// checks it.

export global Theme {
    in-out property <bool> dark: false;

    // surfaces
    out property <color> window: dark ? #1a1c20 : #f3f4f6;
    out property <color> surface: dark ? #22252a : #ffffff;
    out property <color> surface-alt: dark ? #2a2e34 : #eceef1;
    out property <color> border: dark ? #4a515b : #c3c8cf;
    // text
    out property <color> text: dark ? #e6e8eb : #1b1e23;
    out property <color> text-muted: dark ? #a8afb9 : #4f5661;
    // the one accent: the main action's fill, a selection's line, accent text (the current wizard step)
    out property <color> primary: dark ? #3570cc : #1f5fbf;
    out property <color> primary-hover: dark ? #2f6bc8 : #184c99;
    out property <color> primary-text: #ffffff;
    out property <color> accent-text: dark ? #8bb6f5 : #1f5fbf;
    // secondary buttons
    out property <color> button: dark ? #2a2e34 : #ffffff;
    out property <color> button-hover: dark ? #343941 : #eceef1;
    out property <color> button-text: dark ? #e6e8eb : #1b1e23;
    // disabled
    out property <color> disabled: dark ? #26292e : #eceef1;
    out property <color> disabled-text: dark ? #8f96a0 : #5f6670;
    // states: the strong colour marks a state (a notice's bar, a step done, an error's title); the -bg / -text pairs
    // are the quiet tints behind and on a state
    out property <color> success: dark ? #5cc27a : #1d7a3a;
    out property <color> warning: dark ? #e0a83a : #8a5a00;
    out property <color> danger: dark ? #f07167 : #b42318;
    out property <color> danger-bg: dark ? #3a2224 : #fdf0ef;
    out property <color> danger-text: dark ? #ffd2cd : #7a1810;
    out property <color> warning-bg: dark ? #352d1b : #fdf6e3;
    out property <color> warning-text: dark ? #f2d27a : #6b4e00;
    out property <color> success-bg: dark ? #1d3325 : #edf7f0;
    out property <color> success-text: dark ? #a6e3b8 : #14532d;
    // the shade behind a dialog
    out property <color> scrim: dark ? #000000b3 : #00000080;
    // the keyboard focus ring: the accent's deep (light) or pale (dark) shade, never a fill colour
    out property <color> focus: dark ? #9cc3ff : #0b2f66;

    // sizes: normal desktop text and controls, a dense but even rhythm
    out property <length> font: 15px;
    out property <length> font-small: 13px;
    out property <length> font-title: 19px;
    out property <length> font-big: 16px;
    out property <length> pad: 16px;
    out property <length> gap: 10px;
    out property <length> radius: 3px;
    out property <length> control-height: 34px;
}
