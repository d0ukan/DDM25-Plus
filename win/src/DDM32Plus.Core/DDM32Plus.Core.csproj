<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that is not UI: signed manifests (Ed25519), the release list, downloads with hash
       checks, version order, channel labels, the self-update swap, paths and settings, and the radio tools
       (Radio/, ports of pc/radiotools held to them byte for byte). Tested in
       tests/DDM32Plus.Core.Tests against results of the Python code in pc/. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DDM32Plus.Core</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RadioAccess)' == 'true'">
    <!-- On by default (Directory.Build.props): compiles the serial port in (RadioAccess.Enabled). -->
    <DefineConstants>$(DefineConstants);DDM32_RADIO_ACCESS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RadioWrite)' == 'true'">
    <!-- On by default (Directory.Build.props; needs RadioAccess too): the writing tools get a port. -->
    <DefineConstants>$(DefineConstants);DDM32_RADIO_WRITES</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Developer)' == 'true'">
    <!-- Developer-only features (BuildFlags.Developer): local release folder, the developer title. Never in the
         release build or the setup. -->
    <DefineConstants>$(DefineConstants);DDM32_DEVELOPER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="System.IO.Ports" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- From the pinned RadioFoundry files (MIT, LICENSES/RadioFoundry-MIT.txt), written by
         tests/DDM32Plus.Core.Tests/Fixtures/make_radio_fixtures.py: the RAM monitor image (SHA-256 checked before
         use) and the DM32 codec profiles and maps -->
    <EmbeddedResource Include="Radio/Data/ram-monitor.bin" LogicalName="DDM32Plus.Core.Radio.ram-monitor.bin" />
    <EmbeddedResource Include="Radio\Data\codec-dm32.json" LogicalName="DDM32Plus.Core.Radio.codec-dm32.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DDM32Plus.Core.Tests" />
  </ItemGroup>

</Project>
