<UserControl x:Class="DDM32Plus.Views.Pages.VersionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DDM32Plus.Localization">
    <!-- versions_tab.py: every signed release, the update check, "Bu sürüme geç", the program's own update -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Tab_Versions}" />
            <TextBlock x:Name="Banner" Style="{StaticResource Plain}" FontSize="{StaticResource Size3}" />
            <DockPanel Margin="0,4">
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                    <CheckBox x:Name="AutoBox" Content="{l:Tr Ver_AutoCheck}" Margin="0,2" Click="OnAuto" />
                    <CheckBox x:Name="BetaBox" Content="{l:Tr Ver_IncludeBeta}" Margin="0,2" Click="OnBeta" />
                </StackPanel>
                <Button x:Name="CheckButton" Style="{StaticResource BigButton}" Tag="&#xE72C;"
                        ToolTip="{l:Tr Ver_CheckTip}" Click="OnCheck" />
            </DockPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource Plain}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <Button x:Name="SwitchButton" Style="{StaticResource BigButton}" Tag="&#xE72A;" Content="{l:Tr Ver_Switch}"
                    ToolTip="{l:Tr Ver_SwitchTip}" Click="OnSwitch" />
            <GroupBox Header="{l:Tr Ver_Program}" Margin="0,6" Padding="8,4">
                <StackPanel>
                    <TextBlock x:Name="AppLabel" Style="{StaticResource Plain}" />
                    <Button x:Name="AppButton" Style="{StaticResource IconButton}" Tag="&#xE896;" HorizontalAlignment="Left"
                            Content="{l:Tr Ver_UpdateProgram}" ToolTip="{l:Tr Ver_UpdateProgramTip}" Click="OnUpdateApp" />
                    <ProgressBar x:Name="AppProgress" Height="14" Maximum="100" Margin="0,6,0,0" Visibility="Collapsed" />
                </StackPanel>
            </GroupBox>
            <Expander Header="{l:Tr Common_Details}">
                <StackPanel Margin="16,4,0,0">
                    <TextBlock x:Name="KeyText" Margin="0,2" />
                    <TextBox x:Name="RejectedText" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" />
                </StackPanel>
            </Expander>
        </StackPanel>
        <DataGrid x:Name="Table" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#e0e0e0" Margin="0,6"
                  Background="{StaticResource Base}" BorderBrush="{StaticResource Frame}" RowHeaderWidth="0"
                  SelectionChanged="OnSelected" MinHeight="120">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColVersion" Binding="{Binding Version}" Width="Auto" MinWidth="110" />
                <DataGridTemplateColumn x:Name="ColLabel" Width="Auto" MinWidth="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" Foreground="{Binding LabelBrush}" FontWeight="{Binding LabelWeight}" Margin="2,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="ColState" Binding="{Binding State}" Width="Auto" MinWidth="120" />
                <DataGridTemplateColumn x:Name="ColNotes" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Notes}" ToolTip="{Binding NotesTip}" TextTrimming="CharacterEllipsis" Margin="2,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
