<UserControl x:Class="DDM32Plus.Views.Pages.RestorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DDM32Plus.Localization">
    <!-- restore_tab.py: put the radio back from the user's OWN backup -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:Tr Tab_Restore}" />
            <TextBlock Style="{StaticResource Plain}" l:Rich.Text="{l:Tr Res_Text}" />
            <TextBlock x:Name="CableText" Style="{StaticResource Plain}" />
            <UniformGrid Columns="2" Margin="-4,4">
                <Button x:Name="PreviousButton" Style="{StaticResource BigButton}" Tag="&#xE72B;" Margin="4" Content="{l:Tr Res_Previous}"
                        ToolTip="{l:Tr Res_PreviousTip}" Click="OnPrevious" />
                <Button x:Name="StockButton" Style="{StaticResource BigButton}" Tag="&#xE777;" Margin="4" Content="{l:Tr Res_Stock}"
                        ToolTip="{l:Tr Res_StockTip}" Click="OnStock" />
            </UniformGrid>
            <Button x:Name="OtherButton" Content="{l:Tr Res_Other}" HorizontalAlignment="Left" Click="OnOther" />
            <TextBlock x:Name="Status" Style="{StaticResource Plain}" />
            <Button x:Name="RestoreButton" Style="{StaticResource BigButton}" Tag="&#xE73E;" Content="{l:Tr Res_Restore}"
                    ToolTip="{l:Tr Res_RestoreTip}" Margin="0,8,0,4" Click="OnRestore" />
            <Border x:Name="Banner" Style="{StaticResource Banner}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{l:Tr Banner_Title}" FontSize="{StaticResource Size12}" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="BannerCount" FontSize="{StaticResource Size6}" HorizontalAlignment="Center" />
                    <TextBlock Text="{l:Tr Banner_Hint}" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Border>
            <ProgressBar x:Name="Progress" Height="14" Maximum="100" Margin="0,6" />
            <TextBlock x:Name="Result" Style="{StaticResource Plain}" />
            <Border x:Name="AccessNote" Style="{StaticResource NextStage}">
                <StackPanel>
                    <TextBlock Text="{l:Tr Radio_DisabledTitle}" FontWeight="Bold" FontSize="{StaticResource Size2}" />
                    <TextBlock Style="{StaticResource Plain}" Text="{l:Tr Radio_Disabled}" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="OwnBackups" Style="{StaticResource Plain}" />
            <TextBlock x:Name="PythonBackups" Style="{StaticResource Plain}" Foreground="{StaticResource Info}" />
            <Expander Header="{l:Tr Common_Details}">
                <StackPanel Margin="16,4,0,0">
                    <TextBox x:Name="DetailText" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="240" />
                    <TextBox x:Name="LogText" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" Margin="0,6,0,0"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="240" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
