<Window x:Class="DDM32Plus.Views.DisclaimerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DDM32Plus.Localization"
        Title="{l:Tr Disc_WindowTitle}" Width="720" Height="640" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Window}"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True">
    <!-- pc/ddm32_app/disclaimer.py: must be ticked and accepted before any radio step -->
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top">
            <Button x:Name="LangButton" DockPanel.Dock="Right" Click="OnToggleLanguage"
                    ToolTip="{l:Tr Disc_LangTip}" />
            <Border />
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <CheckBox x:Name="Check" Margin="0,10" FontSize="{StaticResource Size2}" FontWeight="Bold"
                      VerticalContentAlignment="Center" Checked="OnCheck" Unchecked="OnCheck">
                <TextBlock Text="{l:Tr Disc_Check}" />
            </CheckBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AcceptButton" Content="{l:Tr Disc_Accept}" IsEnabled="False" MinWidth="120"
                        Margin="0,0,8,0" Click="OnAccept" />
                <Button Content="{l:Tr Disc_Reject}" MinWidth="120" IsCancel="True" />
            </StackPanel>
        </StackPanel>
        <Border Background="{StaticResource Base}" BorderBrush="{StaticResource Frame}" BorderThickness="1" Margin="0,8,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                <StackPanel x:Name="Body" TextElement.FontSize="{StaticResource Size1}" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
